# Resend - Servicio de envío de emails
# Obtené tu API key en https://resend.com/api-keys
RESEND_API_KEY=

# Wibond - Alta automática de clientes (marca blanca)
# Staging: https://connect-api-stg.wibond.co · Producción: https://connect-api.wibond.co
WIBOND_API_URL=
WIBOND_CLIENT_ID=
WIBOND_CLIENT_SECRET=
WIBOND_PARTNER_ID=

# Google Sheet - Registro de intentos de alta en Wibond (vía Apps Script Web App)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_SECRET=
